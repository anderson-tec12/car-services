{
  "expo": {
    "name": "Car Services",
    "slug": "car-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "car-services",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.devtech.carservices",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos e vídeos para registrar manutenções e ocorrências.",
          "cameraPermission": "O app usa a câmera para fotografar e gravar vídeos de manutenções e ocorrências.",
          "microphonePermission": "O app usa o microfone para gravar áudios e vídeos das ocorrências."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F5C400",
          "defaultChannel": "manutencao"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O app usa o microfone para gravar áudios e vídeos das ocorrências.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "358b831a-5a31-4a7b-add0-a48fe6b8ee8a"
      }
    },
    "owner": "anderson.tec1212"
  }
}
